# Anthropic API Key for Claude article generation
ANTHROPIC_API_KEY=sk-ant-...

# Gemini API Key for article generation (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Supabase Configuration (get from supabase.com dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Alpaca Markets API (for real-time stock prices, get from alpaca.markets)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# CoinGecko API Key (optional, for better crypto rate limits, get from coingecko.com)
COINGECKO_API_KEY=


# Required in production: comma-separated emails allowed to use admin tools
# (article generation, cleanup routes). If unset in production, nobody is an admin.
ADMIN_EMAILS=admin@example.com

# Optional: local Python agents (only on a machine that has them installed)
RESEARCH_AGENT_PYTHON=
RESEARCH_AGENT_SCRIPT=
IPO_AGENT_PYTHON=
IPO_AGENT_SCRIPT=
